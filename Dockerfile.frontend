# Dockerfile.frontend

# --- Этап 1: Сборка статических файлов ---
# Используем образ Node.js для сборки проекта
FROM node:20-alpine as builder

# Устанавливаем рабочую директорию
WORKDIR /app

# Копируем файлы package.json из папки ui
COPY ui/package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь остальной код из папки ui
COPY ui/ ./

# Собираем production-версию приложения. Vite по умолчанию кладет результат в /dist
RUN npm run build


# --- Этап 2: Обслуживание статики через Nginx ---
# Используем легковесный образ Nginx
FROM nginx:stable-alpine

# Копируем собранные файлы из этапа 'builder' в директорию Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем кастомный конфиг Nginx для правильной работы React Router (SPA)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Открываем порт 80, который слушает Nginx
EXPOSE 80

# Команда для запуска Nginx на переднем плане
CMD ["nginx", "-g", "daemon off;"]